rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check document for startup connectivity verification
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedAdmin() {
      return isSignedIn()
        && 'email' in request.auth.token
        && 'email_verified' in request.auth.token
        && request.auth.token.email == 'abrehankhan@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidEmailFormat(email) {
      return email is string
        && email.size() >= 3
        && email.size() <= 254
        && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    // UserProfile validation
    function isValidUserPayload(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'provider', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'provider', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() <= 120
        && isValidEmailFormat(data.email)
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.provider in ['google.com', 'password']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ProjectInquiry validation
    function isValidInquiryPayload(data) {
      return data.keys().hasAll(['name', 'email', 'company', 'projectType', 'budget', 'timeline', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'company', 'projectType', 'budget', 'timeline', 'message', 'status', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && isValidEmailFormat(data.email)
        && data.company is string && data.company.size() <= 140
        && data.projectType in [
          'Mobile Application',
          'Web Application',
          'SaaS Product',
          'UI/UX Design',
          'Digital Product',
          'Custom Software'
        ]
        && data.budget is string && data.budget.size() >= 1 && data.budget.size() <= 60
        && data.timeline is string && data.timeline.size() >= 1 && data.timeline.size() <= 60
        && data.message is string && data.message.size() >= 15 && data.message.size() <= 4000
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    // StudioProject validation
    function isValidProjectPayload(data, projectId) {
      return data.keys().hasAll([
          'id', 'index', 'title', 'slug', 'description', 'category',
          'technologies', 'year', 'status', 'featuredImage', 'gallery',
          'storeLinks', 'published', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'index', 'title', 'slug', 'subtitle', 'description', 'category',
          'technologies', 'year', 'status', 'featuredImage', 'gallery',
          'storeLinks', 'published', 'updatedAt'
        ])
        && data.id == projectId
        && isValidId(data.id)
        && data.index is string && data.index.size() >= 1 && data.index.size() <= 16
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 140 && data.slug.matches('^[a-z0-9\\-]+$')
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 200))
        && data.description is string && data.description.size() <= 3000
        && data.category is string && data.category.size() <= 80
        && data.technologies is list && data.technologies.size() <= 20
        && (data.technologies.size() == 0 || data.technologies[0] is string)
        && data.year is string && data.year.size() <= 16
        && data.status is string && data.status.size() <= 80
        && data.featuredImage is string && data.featuredImage.size() <= 500
        && data.gallery is list && data.gallery.size() <= 12
        && data.storeLinks is list && data.storeLinks.size() <= 10
        && data.published is bool
        && data.updatedAt == request.time;
    }

    // Collection: users
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isVerifiedAdmin());
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPayload(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPayload(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'provider', 'updatedAt']);

      allow delete: if false;
    }

    // Collection: inquiries
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isVerifiedAdmin();
      allow list: if isVerifiedAdmin();

      allow create: if isValidId(inquiryId)
        && isValidInquiryPayload(incoming());

      allow update: if isValidId(inquiryId)
        && isVerifiedAdmin()
        && existing().status != 'archived'
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        && incoming().status in ['new', 'reviewed', 'archived'];

      allow delete: if isValidId(inquiryId) && isVerifiedAdmin();
    }

    // Collection: projects
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (isVerifiedAdmin() || (resource != null && existing().published == true));
      allow list: if isVerifiedAdmin() || existing().published == true;

      allow create: if isValidId(projectId)
        && isVerifiedAdmin()
        && isValidProjectPayload(incoming(), projectId);

      allow update: if isValidId(projectId)
        && isVerifiedAdmin()
        && isValidProjectPayload(incoming(), projectId)
        && incoming().id == existing().id;

      allow delete: if isValidId(projectId) && isVerifiedAdmin();
    }
  }
}
